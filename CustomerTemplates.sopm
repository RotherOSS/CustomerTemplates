<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.1">
    <Name>CustomerTemplates</Name>
    <Version>0.0.0</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Provides the customer interface with the standard templates feature.</Description>
    <Description Lang="hu">Lehetővé teszi az ügyfélfelületen a szabványos sablonok funkciót.</Description>
    <Filelist>
        <File Permission="660" Location="Kernel/Config/Files/XML/CustomerTemplate.xml" />
        <File Permission="660" Location="Kernel/Modules/AdminServiceTemplates.pm" />
        <File Permission="660" Location="Custom/Kernel/Modules/CustomerTicketMessage.pm" />
        <File Permission="660" Location="Custom/Kernel/Modules/CustomerTicketZoom.pm" />
        <File Permission="660" Location="Custom/Kernel/Modules/AdminTemplate.pm" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/AdminServiceTemplates.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/CustomerTicketMessage.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/CustomerTicketZoom.tt" />
        <File Permission="660" Location="Custom/Kernel/System/Service.pm" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.Agent.Admin.ServiceTemplates.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.Customer.TicketAction.js" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/Core.FieldExplanationRow.css" />
    </Filelist>
    <DatabaseInstall Type="post">
        <TableCreate Name="service_standard_template">
            <Column Name="service_id" Required="true" Type="INTEGER" />
            <Column Name="standard_template_id" Required="true" Type="INTEGER" />
            <Column Name="create_time" Required="true" Type="DATE" />
            <Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" />
            <Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique>
                <UniqueColumn Name="service_id" />
                <UniqueColumn Name="standard_template_id" />
            </Unique>
            <Index Name="service_standard_template_service_id">
                <IndexColumn Name="service_id" />
            </Index>
            <Index Name="service_standard_template_standard_template_id">
                <IndexColumn Name="standard_template_id" />
            </Index>
            <ForeignKey ForeignTable="service">
                <Reference Local="service_id" Foreign="id" />
            </ForeignKey>
            <ForeignKey ForeignTable="standard_template">
                <Reference Local="standard_template_id" Foreign="id" />
            </ForeignKey>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id" />
                <Reference Local="change_by" Foreign="id" />
            </ForeignKey>
        </TableCreate>
    </DatabaseInstall>
    <DatabaseUninstall Type="pre">
        <TableDrop Name="service_standard_template" />
    </DatabaseUninstall>
</otobo_package>
